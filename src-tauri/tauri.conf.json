{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperMarkdown",
  "version": "0.5.0",
  "identifier": "local.supermarkdown",
  "build": {
    "frontendDist": "../dist-tauri/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SuperMarkdown",
        "width": 1320,
        "height": 940,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "backgroundColor": "#f6f7f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "SuperMarkdown Document",
        "description": "Markdown and text documents",
        "role": "Editor"
      }
    ]
  }
}
