{
  "name": "supermarkdown",
  "version": "0.5.0",
  "private": true,
  "description": "面向 Windows 的 Markdown 可视编辑器",
  "main": "src/app/main.cjs",
  "author": "Chenzy-zero",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node tools/prepare-tauri-frontend.cjs && npx --yes @tauri-apps/cli@2.12.6 dev",
    "test": "node --test tests/*.test.cjs",
    "test:app": "node tools/run-prototype.cjs --ux-verify",
    "test:recovery": "node tools/check-recovery.cjs",
    "test:startup": "node tools/run-prototype.cjs --startup-verify",
    "test:opening": "node tools/check-file-opening.cjs",
    "setup:electron": "node tools/setup-electron.cjs",
    "prototype": "node tools/run-prototype.cjs",
    "prototype:check": "node tools/run-prototype.cjs --verify",
    "prototype:ux-check": "node tools/run-prototype.cjs --ux-verify",
    "dist:win": "node tools/build-windows.cjs",
    "build:editor": "node tools/build-editor.cjs",
    "test:workbench": "node tools/check-workbench.cjs",
    "test:documents": "node tools/check-document-tools.cjs",
    "dev:tauri": "node tools/prepare-tauri-frontend.cjs && npx --yes @tauri-apps/cli@2.12.6 dev",
    "build:tauri": "node tools/prepare-tauri-frontend.cjs && npx --yes @tauri-apps/cli@2.12.6 build --bundles nsis",
    "start:electron-legacy": "node tools/run-prototype.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "iconv-lite": "0.7.3",
    "vditor": "4.0.1"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  }
}
